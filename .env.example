# Copy this file to .env and override values for your local setup.
# Secrets such as API keys or SQL passwords should be rotated per environment.

# Core environment
CRONIQ_DOTNET_ENVIRONMENT=Development
CRONIQ_ENVIRONMENT=dev
# CRONIQ_CORE_TENANT_MODE=Single
# CRONIQ_CORE_TENANT_ID=default
# CRONIQ_CORE_TENANT_NAME=Default

# Service instance identifiers
CRONIQ_API_INSTANCE_ID=api-dev
CRONIQ_WORKER_INSTANCE_ID=worker-dev
# CRONIQ_DMZ_INSTANCE_ID=dmz-dev

# API + worker defaults
CRONIQ_API_HTTP_PORT=5080
CRONIQ_API_INTERNAL_PORT=5080
CRONIQ_API_GRPC_PORT=5082
CRONIQ_API_REQUESTS_PER_MINUTE=240
CRONIQ_API_KEY=ak_default.dev-secret
CRONIQ_RUNNER_DOTNET_API_KEY=ak_dotnet.dev-secret
CRONIQ_RUNNER_GO_API_KEY=ak_go.dev-secret
CRONIQ_RUNNER_NODE_API_KEY=ak_node.dev-secret
CRONIQ_RUNNER_PYTHON_API_KEY=ak_python.dev-secret

# CORS (ApiHost)
# CRONIQ_API_CORS_ALLOWED_ORIGINS_0=https://ui.croniq.local

# Execution logs (ApiHost)
CRONIQ_LOGGING_EXECUTION_BASEPATH=logs

# Worker dispatch (gRPC)
CRONIQ_RUNNER_ID=default
# CRONIQ_RUNNER_REGISTER_JOBS=true
CRONIQ_WORKER_DISPATCH_ENABLE_GRPC=true
CRONIQ_WORKER_DISPATCH_GRPC_ENDPOINT=http://localhost:5082
CRONIQ_WORKER_DISPATCH_API_KEY=ak_worker.dev-secret
CRONIQ_WORKER_DISPATCH_RUNNER_ID=worker-default
CRONIQ_WORKER_DISPATCH_RECONNECT_DELAY=00:00:05
CRONIQ_WORKER_DISPATCH_FALLBACK_IDLE_DELAY=00:00:05
CRONIQ_WORKER_DISPATCH_FALLBACK_BUSY_DELAY=00:00:01
CRONIQ_WORKER_DISPATCH_FALLBACK_ERROR_DELAY=00:00:05

# Webhooks + ingress
CRONIQ_WEBHOOKS_MODE=Remote
CRONIQ_WEBHOOKS_HTTP_PORT=5082
CRONIQ_WEBHOOKS_REMOTE_TIMEOUT_SECONDS=30

# DMZ (ingress + admin)
CRONIQ_DEVSTACK_DMZ=true
CRONIQ_DMZ_HTTP_PORT=5000
CRONIQ_DMZ_GRPC_PORT=5001
CRONIQ_DMZ_ADMIN_HTTP_PORT=5002
CRONIQ_DMZ_SQL_DATABASE=CroniqDmz
CRONIQ_DMZ_API_KEY=dmz-dev-key
CRONIQ_DMZ_BASEURL=https://dmz.croniq.local
CRONIQ_DMZ_INGRESS_BASEURL=https://hooks.croniq.local
CRONIQ_DMZ_AUTH_MODE=InMemory
CRONIQ_DMZ_DATAPROTECTION_APPLICATIONNAME=Croniq.Dmz
CRONIQ_DMZ_DATAPROTECTION_KEYRINGPATH=/var/lib/croniq/dmz-keys

# Reverse proxy forwarded headers (optional)
# CRONIQ_API_FORWARDED_HEADERS_ENABLED=false
# CRONIQ_API_FORWARDED_HEADERS_FORWARD_LIMIT=1
# CRONIQ_API_FORWARDED_HEADERS_KNOWN_NETWORKS_0=10.0.0.0/8
# CRONIQ_API_FORWARDED_HEADERS_KNOWN_PROXIES_0=192.168.1.10

# Auth defaults (set to InMemory to disable password login endpoints)
CRONIQ_AUTH_MODE=SqlServer

# Shared Data Protection key ring for webhook secrets
# Keep this consistent across API + webhooks and persist the directory via a shared volume.
CRONIQ_SECURITY_DATAPROTECTION_APPLICATIONNAME=Croniq
CRONIQ_SECURITY_DATAPROTECTION_KEYRINGPATH=/var/lib/croniq/keys

# SQL Server credentials + ports
CRONIQ_SQL_PASSWORD=CroniqSqlP@ssw0rd!
CRONIQ_SQL_HOST_PORT=11433
CRONIQ_SQL_DATABASE=CroniqDev
CRONIQ_SQL_HOST=mssql-22

# Postgres credentials + ports (optional)
# CRONIQ_POSTGRES_PASSWORD=postgres
# CRONIQ_POSTGRES_HOST_PORT=15432
# CRONIQ_POSTGRES_DATABASE=CroniqDev
# CRONIQ_POSTGRES_HOST=postgres-16
# CRONIQ_POSTGRES_USER=postgres
# CRONIQ_DB_PROVIDER=Postgres
# CRONIQ_POSTGRES_CONNECTION=Host=postgres-16;Port=5432;Database=CroniqDev;Username=postgres;Password=postgres

# Optional: OIDC bearer validation (external IdP)
# CRONIQ_AUTH_OIDC_ENABLED=true
# CRONIQ_AUTH_OIDC_AUTHORITY=https://auth.localhost:9091
# CRONIQ_AUTH_OIDC_METADATA_ADDRESS=https://auth.localhost:9091/.well-known/openid-configuration
# CRONIQ_AUTH_OIDC_AUDIENCE=croniq-api
# CRONIQ_AUTH_OIDC_REQUIRE_HTTPS_METADATA=true
# CRONIQ_AUTH_OIDC_TENANT_CLAIM=tenant
# CRONIQ_AUTH_OIDC_TENANT_FALLBACK_CLAIMS_0=tid
# CRONIQ_AUTH_OIDC_ENVIRONMENT_CLAIM=env
# CRONIQ_AUTH_OIDC_CALLER_ID_CLAIM=sub
# CRONIQ_AUTH_OIDC_SCOPE_CLAIMS_0=scope
# CRONIQ_AUTH_OIDC_SCOPE_CLAIMS_1=scp
# CRONIQ_AUTH_OIDC_REQUIRED_SCOPES_0=ui:access
# CRONIQ_AUTH_OIDC_DEFAULT_ENVIRONMENT=dev

# Optional: OIDC login (backend code exchange + HttpOnly refresh cookie)
# CRONIQ_AUTH_OIDC_LOGIN_ENABLED=true
# CRONIQ_AUTH_OIDC_LOGIN_CLIENT_ID=croniq-ui
# CRONIQ_AUTH_OIDC_LOGIN_CLIENT_SECRET=
# CRONIQ_AUTH_OIDC_LOGIN_REDIRECT_URI=https://api.localhost:5080/auth/oidc/callback
# CRONIQ_AUTH_OIDC_LOGIN_UI_BASE_URL=http://localhost:4200
# CRONIQ_AUTH_OIDC_LOGIN_SCOPES_0=openid
# CRONIQ_AUTH_OIDC_LOGIN_SCOPES_1=profile
# CRONIQ_AUTH_OIDC_LOGIN_SCOPES_2=offline_access
# CRONIQ_AUTH_OIDC_LOGIN_REFRESH_COOKIE_LIFETIME_DAYS=7
# CRONIQ_AUTH_OIDC_LOGIN_COOKIE_SAMESITE=Lax
# CRONIQ_AUTH_OIDC_LOGIN_COOKIE_SECURE=true
# CRONIQ_AUTH_OIDC_LOGIN_COOKIE_DOMAIN=

# Tenant seeding (dev)
# CRONIQ_SEED_TENANT=true
# CRONIQ_SEED_TENANT_ID=
# CRONIQ_SEED_TENANT_NAME=
# CRONIQ_SEED_TENANT_REFERENCE=

# API key seeding (dev)
# Format: keyId.secret|clientId|name|scopes|environment (entries separated by ';')
CRONIQ_SEED_API_KEYS=ak_default.dev-secret|default|Dev API|all|dev;ak_worker.dev-secret|worker-default|Worker Host|work:poll,work:renew,work:ack,work:events|dev;ak_dotnet.dev-secret|dotnet-default|.NET Runner|work:poll,work:renew,work:ack,work:events,jobs:register,runners:heartbeat,runners:read|dev;ak_go.dev-secret|go-default|Go Runner|work:poll,work:renew,work:ack,work:events,jobs:register,runners:heartbeat,runners:read|dev;ak_node.dev-secret|node-default|Node Runner|work:poll,work:renew,work:ack,work:events,jobs:register,runners:heartbeat,runners:read|dev;ak_python.dev-secret|python-default|Python Runner|work:poll,work:renew,work:ack,work:events,jobs:register,runners:heartbeat,runners:read|dev
CRONIQ_SEED_API_KEY_OVERWRITE=true

# Password auth dev seeding
CRONIQ_SEED_ADMIN=true
CRONIQ_SEED_ADMIN_USERNAME=admin
CRONIQ_SEED_ADMIN_PASSWORD=admin
CRONIQ_SEED_ADMIN_PASSWORD_CHANGE_REQUIRED=true
CRONIQ_SEED_ADMIN_OVERWRITE=true
# CRONIQ_SEED_ADMIN_SCOPES=jobs:read jobs:write schedules:write runners:write
CRONIQ_SEED_ADMIN_SCOPES=all

# UI / client defaults
CRONIQ_UI_HTTP_PORT=5081
CRONIQ_UI_API_BASEURL=https://api.croniq.local
CRONIQ_UI_SWAGGER_UI_URL=https://api.croniq.local/swagger
CRONIQ_UI_DEFAULT_TENANT_ID=default
# CRONIQ_DEVSTACK_UI=false
# CRONIQ_UI_WEBHOOKS_ACTIVITY_STREAM_MODE=grpc
# CRONIQ_UI_WEBHOOKS_ACTIVITY_GRPC_BASEURL=http://localhost:5080
# CRONIQ_UI_WEBHOOKS_ACTIVITY_SSE_BASEURL=http://localhost:5080

# Documentation site
CRONIQ_DEVSTACK_DOCS=true
CRONIQ_DOCS_HTTP_PORT=5173

# Observability profile
# CRONIQ_DEVSTACK_OBS=false

# Local TLS proxy (Caddy)
CRONIQ_CADDY_DOMAIN=croniq.local
CRONIQ_CADDY_UPSTREAM_HOST=host.docker.internal
CRONIQ_CADDY_HTTP_PORT=80
CRONIQ_CADDY_HTTPS_PORT=443
# CRONIQ_DEVSTACK_CADDY=false

# Observability / tooling
CRONIQ_OBS_OTLP_ENDPOINT=http://otel-collector:4317
CRONIQ_OBS_OTLP_PROTOCOL=grpc
# CRONIQ_OBS_HASH_IDENTIFIERS=false
# CRONIQ_OBS_IDENTIFIER_HASH_KEY=
CRONIQ_GRAFANA_USER=admin
CRONIQ_GRAFANA_PASSWORD=admin
CRONIQ_GRAFANA_PORT=5610
CRONIQ_PROMETHEUS_PORT=9090
CRONIQ_TEMPO_HTTP_PORT=3200
CRONIQ_LOKI_HTTP_PORT=3100
CRONIQ_OTLP_GRPC_PORT=4317
CRONIQ_OTLP_HTTP_PORT=4318
CRONIQ_OTEL_PROM_PORT=8889
