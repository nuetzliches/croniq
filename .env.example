# Copy this file to .env and override the values for your local setup
# Secrets such as API keys or SQL passwords should be rotated per environment.

# SQL Server credentials + ports
CRONIQ_SQL_PASSWORD=CroniqSqlP@ssw0rd!
CRONIQ_SQL_HOST_PORT=11433
CRONIQ_SQL_DATABASE=CroniqDev
CRONIQ_SQL_HOST=mssql-22

# Postgres credentials + ports (optional)
# CRONIQ_POSTGRES_PASSWORD=postgres
# CRONIQ_POSTGRES_HOST_PORT=15432
# CRONIQ_POSTGRES_DATABASE=CroniqDev
# CRONIQ_POSTGRES_HOST=postgres-16
# CRONIQ_POSTGRES_USER=postgres
# CRONIQ_DB_PROVIDER=Postgres
# CRONIQ_POSTGRES_CONNECTION=Host=postgres-16;Port=5432;Database=CroniqDev;Username=postgres;Password=postgres

# API/worker defaults
CRONIQ_DOTNET_ENVIRONMENT=Development
# CRONIQ_CORE_TENANT_MODE=Single
# CRONIQ_CORE_TENANT_ID=default
# CRONIQ_CORE_TENANT_NAME=Default
CRONIQ_ENVIRONMENT=dev
CRONIQ_API_INSTANCE_ID=api-dev
CRONIQ_WORKER_INSTANCE_ID=worker-dev
# RunnerId must match the API client id used by the worker credentials.
CRONIQ_RUNNER_ID=default
CRONIQ_API_HTTP_PORT=5080
CRONIQ_API_INTERNAL_PORT=5080
CRONIQ_API_REQUESTS_PER_MINUTE=240
CRONIQ_API_KEY=smoke-key
# Reverse proxy forwarded headers (optional)
# CRONIQ_API_FORWARDED_HEADERS_ENABLED=false
# CRONIQ_API_FORWARDED_HEADERS_FORWARD_LIMIT=1
# CRONIQ_API_FORWARDED_HEADERS_KNOWN_NETWORKS_0=10.0.0.0/8
# CRONIQ_API_FORWARDED_HEADERS_KNOWN_PROXIES_0=192.168.1.10

# Set CRONIQ_AUTH_MODE=SqlServer or Postgres if you want to use /auth/login in the devstack.
# CRONIQ_AUTH_MODE=InMemory

# Optional: OIDC bearer validation (for external IdPs such as Authelia).
# When enabled, Croniq-minted bearer tokens (password login / token issuance) are rejected.
# These map to Croniq:Auth:Oidc:* (see CroniqOidcOptions).
# CRONIQ_AUTH_OIDC_ENABLED=true
# CRONIQ_AUTH_OIDC_AUTHORITY=https://auth.localhost:9091
# CRONIQ_AUTH_OIDC_METADATA_ADDRESS=https://auth.localhost:9091/.well-known/openid-configuration
# CRONIQ_AUTH_OIDC_AUDIENCE=croniq-api
# CRONIQ_AUTH_OIDC_REQUIRE_HTTPS_METADATA=true
# CRONIQ_AUTH_OIDC_TENANT_CLAIM=tenant
# CRONIQ_AUTH_OIDC_TENANT_FALLBACK_CLAIMS_0=tid
# CRONIQ_AUTH_OIDC_ENVIRONMENT_CLAIM=env
# CRONIQ_AUTH_OIDC_CALLER_ID_CLAIM=sub
# CRONIQ_AUTH_OIDC_SCOPE_CLAIMS_0=scope
# CRONIQ_AUTH_OIDC_SCOPE_CLAIMS_1=scp
# CRONIQ_AUTH_OIDC_REQUIRED_SCOPES_0=ui:access
# CRONIQ_AUTH_OIDC_DEFAULT_ENVIRONMENT=dev

# Optional: OIDC login (backend code exchange + HttpOnly refresh cookie).
# These map to Croniq:Auth:OidcLogin:* (see CroniqOidcLoginOptions).
# CRONIQ_AUTH_OIDC_LOGIN_ENABLED=true
# CRONIQ_AUTH_OIDC_LOGIN_CLIENT_ID=croniq-ui
# CRONIQ_AUTH_OIDC_LOGIN_CLIENT_SECRET=
# CRONIQ_AUTH_OIDC_LOGIN_REDIRECT_URI=https://api.localhost:5080/auth/oidc/callback
# CRONIQ_AUTH_OIDC_LOGIN_UI_BASE_URL=http://localhost:4200
# CRONIQ_AUTH_OIDC_LOGIN_SCOPES_0=openid
# CRONIQ_AUTH_OIDC_LOGIN_SCOPES_1=profile
# CRONIQ_AUTH_OIDC_LOGIN_SCOPES_2=offline_access
# CRONIQ_AUTH_OIDC_LOGIN_REFRESH_COOKIE_LIFETIME_DAYS=7
# CRONIQ_AUTH_OIDC_LOGIN_COOKIE_SAMESITE=Lax
# CRONIQ_AUTH_OIDC_LOGIN_COOKIE_SECURE=true
# CRONIQ_AUTH_OIDC_LOGIN_COOKIE_DOMAIN=

# Tenant seeding for password auth dev seeding (used by croniq-db-migrator in docker-compose.dev.yml)
# Optional: if omitted, seeding falls back to CRONIQ_CORE_TENANT_ID / CRONIQ_CORE_TENANT_NAME (or tenant id).
# CRONIQ_SEED_TENANT_ID=
# CRONIQ_SEED_TENANT_NAME=
# CRONIQ_SEED_TENANT_REFERENCE=

# Password auth dev seeding (used by croniq-db-migrator in docker-compose.dev.yml)
CRONIQ_SEED_ADMIN=true
CRONIQ_SEED_ADMIN_USERNAME=admin
CRONIQ_SEED_ADMIN_PASSWORD=admin
CRONIQ_SEED_ADMIN_PASSWORD_CHANGE_REQUIRED=true
# CRONIQ_SEED_ADMIN_OVERWRITE=true

# Optional: override scopes/permissions for the seeded admin.
# - Separators: comma and/or whitespace
# - Special value: "all" grants all known Croniq scopes
#CRONIQ_SEED_ADMIN_SCOPES=jobs:read jobs:write schedules:write
CRONIQ_SEED_ADMIN_SCOPES=all

# UI / client defaults
CRONIQ_UI_HTTP_PORT=5081
CRONIQ_UI_API_BASEURL=http://localhost:5080
CRONIQ_UI_SWAGGER_UI_URL=http://localhost:5080/swagger
CRONIQ_UI_DEFAULT_TENANT_ID=default
# CRONIQ_UI_WEBHOOKS_ACTIVITY_STREAM_MODE=grpc
# CRONIQ_UI_WEBHOOKS_ACTIVITY_GRPC_BASEURL=http://localhost:5080
# CRONIQ_UI_WEBHOOKS_ACTIVITY_SSE_BASEURL=http://localhost:5080

# Observability / tooling
CRONIQ_OBS_OTLP_ENDPOINT=http://otel-collector:4317
CRONIQ_OBS_OTLP_PROTOCOL=grpc
# Optional: hash tenant/caller identifiers in logs/metrics/traces (HMAC-SHA256).
# Set to "true" and provide a secret key.
# CRONIQ_OBS_HASH_IDENTIFIERS=false
# CRONIQ_OBS_IDENTIFIER_HASH_KEY=
CRONIQ_GRAFANA_USER=admin
CRONIQ_GRAFANA_PASSWORD=admin
CRONIQ_GRAFANA_PORT=5610
CRONIQ_PROMETHEUS_PORT=9090
CRONIQ_TEMPO_HTTP_PORT=3200
CRONIQ_LOKI_HTTP_PORT=3100
CRONIQ_OTLP_GRPC_PORT=4317
CRONIQ_OTLP_HTTP_PORT=4318
CRONIQ_OTEL_PROM_PORT=8889

# DMZ sample defaults
CRONIQ_SAMPLE_DMZ_SQL_DATABASE=CroniqDmz
CRONIQ_SAMPLE_DMZ_API_KEY=dmz-sample-key
CRONIQ_SAMPLE_DMZ_HTTP_PORT=5000
CRONIQ_SAMPLE_DMZ_GRPC_PORT=5001
# CRONIQ_SAMPLE_DMZ_BASEURL=https://localhost:5001
# CRONIQ_SAMPLE_DMZ_AUTH_MODE=InMemory
# CRONIQ_SAMPLE_DMZ_INSTANCE_ID=dmz-dev
