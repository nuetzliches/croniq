# Croniqfile.demo — Quickstart / Demo Profile
#
# Start the full stack with:
#   docker compose up
#
# The demo runner connects automatically and handles all jobs below.

server {
  listen :4000
  data_dir /var/lib/croniq
  db sqlite
}

pull_api {
  # The JWT signing secret for runner tokens is taken from
  # CRONIQ_JWT_SECRET, or auto-generated into $DATA_DIR/jwt.secret on
  # first boot. Runners still need a seeded, scoped API key to connect
  # (see `croniq init --api-key …`) — there is no anonymous work access.
  lease_ttl 60s
}

observability {
  log { level info; format text; output stderr }
}

defaults {
  retry fixed { max_attempts 3; delay 5s }
  timeout 2m
  dead_letter { retention 7d }
}

# ── Demo jobs ────────────────────────────────────────────────────────────────

job demo:heartbeat {
  description "Liveness ping — runs every minute"
  every 1 minute
  timeout 30s
  tags "env=demo" "kind=health"
}

job demo:data-sync {
  description "Incremental data sync — runs every 5 minutes"
  every 5 minutes
  timeout 1m
  retry fixed { max_attempts 2; delay 10s }
  tags "env=demo" "kind=etl" "team=data"
}

job demo:report {
  description "Generates a summary report — runs every 15 minutes"
  every 15 minutes
  timeout 90s
  tags "env=demo" "kind=report" "team=data"
}

job demo:cleanup {
  description "Removes stale temp files — runs every hour"
  every 1 hour
  timeout 5m
  dead_letter { retention 3d }
  tags "env=demo" "kind=ops"
}

job demo:slow-job {
  description "Simulates a long-running task (catches timeouts)"
  every 30 minutes
  timeout 45s
  retry fixed { max_attempts 1; delay 0s }
  tags "env=demo" "kind=ops"
}

# --- Alerting ---
#
# The demo deliberately fails some runs (RUNNER_FAIL_RATE in the shell runner),
# and without a rule that goes nowhere: the alerting surface stays empty and
# the dashboard's Alerts screen has nothing to show. One channel and one rule
# make the feature visible in the demo the same way the jobs above make the
# scheduler visible.
#
# `alerts { }` is read at boot only — a config reload reports it as a pending
# restart rather than applying it (see docs/operations.md).
alerts {
  # Shell delivery runs `sh -c <command>`; this one just writes a line to the
  # server's stdout, so the demo shows deliveries without needing anywhere to
  # send them.
  channel "demo-log" {
    shell "echo croniq demo alert"
  }

  rule "demo-failures" {
    when job_failed
    job_key "demo:*"
    # One failed attempt is enough to say something in a demo; a real rule
    # would usually wait for the retries to be exhausted.
    min_attempts 1
    throttle 5m
    channels "demo-log"
  }
}
