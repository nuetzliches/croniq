    "SqlServer": {
      "ConnectionString": "Server=localhost,11433;Database=CroniqDev;User Id=sa;Password=CroniqSqlP@ssw0rd!;Encrypt=True;TrustServerCertificate=True;"
    },
    "Postgres": {
      "ConnectionString": "Host=localhost;Port=5432;Database=CroniqDev;Username=postgres;Password=postgres"
    },
    "Observability": {
