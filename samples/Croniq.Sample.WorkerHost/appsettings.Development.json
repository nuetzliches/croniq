{
  "Croniq": {
    "Policies": {
      "Misfire": {
        "MaxMisfireDelay": "00:03:00",
        "DeadLetterOnMisfire": true,
        "RescheduleBackoff": "00:00:15"
      },
      "Execution": {
        "Retry": {
          "MaxAttempts": 3,
          "BackoffStrategy": "Exponential",
          "InitialDelay": "00:00:02",
          "MaxDelay": "00:00:20",
          "JitterFactor": 0.2
        },
        "Timeout": {
          "Timeout": "00:01:00",
          "CancelExecutionOnTimeout": true
        },
        "DeadLetter": {
          "OperatorHint": "check sample downstream"
        }
      },
      "Overrides": {
        "Execution": [
          {
            "TenantId": "default",
            "NamespaceSegment": "samples",
            "JobName": "smoke",
            "Options": {
              "Timeout": {
                "Timeout": "00:00:20"
              },
              "Retry": {
                "MaxAttempts": 2
              }
            }
          }
        ]
      }
    },
    "JobRegistrySync": {
      "Mode": "CreateIfMissing",
      "ManagedBy": "croniq-sample"
    }
  }
}
