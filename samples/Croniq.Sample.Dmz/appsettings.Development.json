{
  "Croniq": {
    "Api": {
      "Surface": "WebhookAdminOnly",
      "RequestsPerMinute": 30,
      "AllowedIpCidrs": [
        "127.0.0.1/32",
        "::1/128"
      ]
    },
    "Auth": {
      "Tokens": {
        "Enabled": false
      },
      "Password": {
        "Enabled": false
      }
    },
    "Webhooks": {
      "Mode": "SqlServer",
      "RequestsPerMinute": 30,
      "Ingress": {
        "DispatchMode": "StoreOnly",
        "LeaseSeconds": 30,
        "MaxBatchSize": 100,
        "PollingIntervalMilliseconds": 250
      },
      "Security": {
        "AllowUnsignedHooks": true
      }
    }
  }
}
