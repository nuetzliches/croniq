{
  "id": null,
  "uid": "croniq-logs",
  "title": "Croniq Log Pulse",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "style": "dark",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({tenant!=\"\"}, tenant)",
        "query": "label_values({tenant!=\"\"}, tenant)",
        "refresh": 2,
        "sort": 1,
        "options": [],
        "current": {
          "selected": true,
          "text": "croniq-devstack",
          "value": "croniq-devstack"
        }
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({tenant=~\"$tenant\", tenant!=\"\"}, environment)",
        "query": "label_values({tenant=~\"$tenant\", tenant!=\"\"}, environment)",
        "refresh": 2,
        "sort": 1,
        "options": [],
        "current": {
          "selected": true,
          "text": "dev",
          "value": "dev"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Logs per Service (5m)",
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({tenant=\"$tenant\", environment=~\"$environment\", service_name=~\".+\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Log Level Mix (5m)",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({tenant=\"$tenant\", environment=~\"$environment\", service_name=~\".+\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "logs",
      "title": "Latest WARN / ERROR",
      "id": 3,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{tenant=\"$tenant\", environment=~\"$environment\", service_name=~\".+\", level=~\"WARN|ERROR\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showCommonLabels": true,
        "wrapLogMessage": true
      }
    },
    {
      "type": "logs",
      "title": "Latest Trigger INFO",
      "id": 4,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{tenant=\"$tenant\", environment=~\"$environment\", service_name=~\".+\", level=\"INFO\"} |= \"trigger\"",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showCommonLabels": true,
        "wrapLogMessage": true
      }
    }
  ]
}
