{
    "id": null,
    "uid": "croniq-api",
    "title": "Croniq API Gateway",
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "style": "dark",
    "editable": true,
    "refresh": "30s",
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "panels": [
        {
            "type": "timeseries",
            "title": "Schedule Upserts",
            "id": 1,
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(cronigateway_schedule_upserts_total[5m])) by (tenant)",
                    "legendFormat": "tenant={{tenant}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "color": {
                        "mode": "palette-classic"
                    }
                },
                "overrides": []
            }
        },
        {
            "type": "timeseries",
            "title": "Manual Triggers",
            "id": 2,
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(cronigateway_manual_triggers_total[5m])) by (tenant)",
                    "legendFormat": "tenant={{tenant}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "color": {
                        "mode": "palette-classic"
                    }
                },
                "overrides": []
            }
        },
        {
            "type": "timeseries",
            "title": "Policy Outcomes",
            "id": 3,
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(cronipolicy_retry_attempts[5m]))",
                    "legendFormat": "retry attempts",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(cronipolicy_circuit_open[5m]))",
                    "legendFormat": "circuit open",
                    "refId": "B"
                },
                {
                    "expr": "sum(rate(cronipolicy_deadletter_total[5m]))",
                    "legendFormat": "dead letters",
                    "refId": "C"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "color": {
                        "mode": "palette-classic"
                    }
                },
                "overrides": []
            }
        }
    ]
}