# syntax=docker/dockerfile:1.7

ARG DOTNET_VERSION=10.0

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build-base
WORKDIR /src

COPY croniq.sln .
COPY Directory.Build.props .

COPY src/*/*.csproj src/*/
COPY samples/Croniq.Sample.ApiHost/*.csproj samples/Croniq.Sample.ApiHost/
COPY samples/Croniq.Sample.WorkerHost/*.csproj samples/Croniq.Sample.WorkerHost/
COPY tools/Croniq.DbMigrator/*.csproj tools/Croniq.DbMigrator/

RUN --mount=type=cache,id=nuget-packages,target=/root/.nuget/packages \
	--mount=type=cache,id=nuget-http-cache,target=/root/.local/share/NuGet/v3-cache \
	set -eux; \
	dotnet restore samples/Croniq.Sample.ApiHost/Croniq.Sample.ApiHost.csproj; \
	dotnet restore samples/Croniq.Sample.WorkerHost/Croniq.Sample.WorkerHost.csproj; \
	dotnet restore tools/Croniq.DbMigrator/Croniq.DbMigrator.csproj

COPY . .

FROM build-base AS publish-api
RUN --mount=type=cache,id=nuget-packages,target=/root/.nuget/packages \
	--mount=type=cache,id=nuget-http-cache,target=/root/.local/share/NuGet/v3-cache \
	dotnet publish samples/Croniq.Sample.ApiHost/Croniq.Sample.ApiHost.csproj -c Release -o /app/publish /p:UseAppHost=false --no-restore

FROM build-base AS publish-worker
RUN --mount=type=cache,id=nuget-packages,target=/root/.nuget/packages \
	--mount=type=cache,id=nuget-http-cache,target=/root/.local/share/NuGet/v3-cache \
	dotnet publish samples/Croniq.Sample.WorkerHost/Croniq.Sample.WorkerHost.csproj -c Release -o /app/publish /p:UseAppHost=false --no-restore

FROM build-base AS publish-migrator
RUN --mount=type=cache,id=nuget-packages,target=/root/.nuget/packages \
	--mount=type=cache,id=nuget-http-cache,target=/root/.local/share/NuGet/v3-cache \
	dotnet publish tools/Croniq.DbMigrator/Croniq.DbMigrator.csproj -c Release -o /app/publish /p:UseAppHost=false --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION} AS api
WORKDIR /app
COPY --from=publish-api /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "Croniq.Sample.ApiHost.dll"]

FROM mcr.microsoft.com/dotnet/runtime:${DOTNET_VERSION} AS worker
WORKDIR /app
COPY --from=publish-worker /app/publish .
ENTRYPOINT ["dotnet", "Croniq.Sample.WorkerHost.dll"]

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION} AS migrator
WORKDIR /app
COPY --from=publish-migrator /app/publish .
ENTRYPOINT ["dotnet", "Croniq.DbMigrator.dll"]
