<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.71.0" />
    <PackageReference Include="Google.Protobuf" Version="3.27.1" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\scheduler.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\runner.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\webhook_ingress.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\webhook_activity.proto" GrpcServices="Client" />
  </ItemGroup>
</Project>
