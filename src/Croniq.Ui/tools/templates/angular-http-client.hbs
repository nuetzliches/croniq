import { z } from 'zod';

{{#if types}}
{{#each types}}
{{{this}}};
{{/each}}
{{/if}}

{{#each schemas}}
export const {{@key}}{{#if (lookup ../emittedType @key)}}: z.ZodType<{{@key}}>{{/if}} = {{{this}}};
export type {{@key}} = z.infer<typeof {{@key}}>;
{{/each}}

{{#ifNotEmptyObj schemas}}
export const schemas = {
{{#each schemas}}
    {{@key}},
{{/each}}
};
{{/ifNotEmptyObj}}

export type HttpMethod = 'get' | 'post' | 'put' | 'patch' | 'delete' | 'options' | 'head';
export type RequestFormat = 'json' | 'binary' | 'form-data' | 'url-encoded' | 'multipart' | 'unknown';
export type ParameterLocation = 'Path' | 'Query' | 'Body' | 'Header';

export interface EndpointParameter<TSchema = unknown> {
    name: string;
    description?: string;
    type?: ParameterLocation;
    schema: TSchema;
}

export interface EndpointError<TSchema = unknown> {
    status: number | 'default';
    description?: string;
    schema: TSchema;
}

export interface EndpointDefinition<TResponse = unknown> {
    method: HttpMethod;
    path: string;
    description?: string;
    alias?: string;
    requestFormat?: RequestFormat;
    parameters?: EndpointParameter[];
    response: TResponse;
    errors?: EndpointError[];
}

export type EndpointList = ReadonlyArray<EndpointDefinition>;
