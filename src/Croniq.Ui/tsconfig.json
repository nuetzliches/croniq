/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "data-access": ["./projects/data-access/src/public-api.ts", "./dist/data-access"],
      "telemetry": ["./projects/telemetry/src/public-api.ts", "./dist/telemetry"],
      "ui-kit": ["./projects/ui-kit/src/public-api.ts", "./dist/ui-kit"],
      "@croniq/api-schema": ["./projects/api-schema/src/index.ts"],
      "@croniq/api-schema/*": ["./projects/api-schema/src/*"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "controlFlow": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./projects/data-access/tsconfig.lib.json"
    },
    {
      "path": "./projects/data-access/tsconfig.spec.json"
    },
    {
      "path": "./projects/telemetry/tsconfig.lib.json"
    },
    {
      "path": "./projects/telemetry/tsconfig.spec.json"
    },
    {
      "path": "./projects/ui-kit/tsconfig.lib.json"
    },
    {
      "path": "./projects/ui-kit/tsconfig.spec.json"
    }
  ]
}
