{
  "name": "croniq.ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "tsx tools/generate-runtime-config.ts",
    "start": "ng serve",
    "prebuild": "tsx tools/generate-runtime-config.ts",
    "build": "ng build",
    "prewatch": "tsx tools/generate-runtime-config.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:once": "ng test --no-watch",
    "test:ci": "cross-env CI=1 ng test --no-watch",
    "test:list": "ng test --list-tests --no-watch",
    "mcp": "ng mcp",
    "generate:runtime-config": "tsx tools/generate-runtime-config.ts",
    "generate:api": "tsx tools/generate-schemas.ts",
    "generate:api:server": "cross-env CRONIQ_OPENAPI_URL=http://localhost:5080/swagger/v1/swagger.json tsx tools/generate-schemas.ts",
    "generate:api:server:snapshot": "cross-env CRONIQ_OPENAPI_URL=http://localhost:5080/swagger/v1/swagger.json tsx tools/generate-schemas.ts --update-snapshot",
    "snapshot:swagger": "cross-env CRONIQ_OPENAPI_URL=http://localhost:5080/swagger/v1/swagger.json tsx tools/snapshot-swagger.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.0.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0 <12"
  },
  "dependencies": {
    "@angular/aria": "^21.1.0",
    "@angular/cdk": "^21.1.0",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv": "^8.12.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.1.0",
    "openapi-zod-client": "^1.18.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.7.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
