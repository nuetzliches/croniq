{
  "name": "croniq.ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:once": "ng test --no-watch",
    "test:ci": "cross-env CI=1 ng test --no-watch",
    "test:list": "ng test --list-tests --no-watch",
    "mcp": "ng mcp",
    "generate:api": "tsx tools/generate-schemas.ts",
    "generate:api:server": "cross-env CRONIQ_OPENAPI_URL=http://localhost:5000/swagger/v1/swagger.json tsx tools/generate-schemas.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.0.0",
  "dependencies": {
    "@angular/common": "^21.0.3",
    "@angular/compiler": "^21.0.3",
    "@angular/core": "^21.0.3",
    "@angular/forms": "^21.0.3",
    "@angular/platform-browser": "^21.0.3",
    "@angular/router": "^21.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.3",
    "@apidevtools/swagger-parser": "^12.1.0",
    "ajv": "^8.12.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.0.0",
    "openapi-zod-client": "^1.18.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.7.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}