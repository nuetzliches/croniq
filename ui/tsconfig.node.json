{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // The e2e suite belongs here rather than in tsconfig.app.json: it runs in
  // Node under Playwright, not in the bundle. Without it `tsc -b` type checks
  // neither the specs nor the config, and a type error in a spec would only
  // surface when the suite runs.
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e"]
}
