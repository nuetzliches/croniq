{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nuetzliches/croniq/sdks/conformance/schema/case-schema.json",
  "title": "Croniq runner conformance case",
  "description": "Schema for a single language-agnostic conformance case YAML file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "runner_config", "handlers", "server_script", "expectations"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },

    "runner_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runner_id": { "type": "string" },
        "runner_id_prefix": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "max_inflight": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "api_key": { "type": "string" },
        "bearer_token": { "type": "string" },
        "poll_timeout_ms": { "type": "integer", "minimum": 1 },
        "renew_interval_ms": { "type": "integer", "minimum": 1 },
        "drain_timeout_ms": { "type": "integer", "minimum": 1 },
        "poll_retry_delay_ms": { "type": "integer", "minimum": 1 },
        "capacity_backoff_ms": { "type": "integer", "minimum": 1 },
        "max_consecutive_poll_conflicts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_consecutive_auth_failures": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },

    "handlers": {
      "type": "array",
      "items": { "$ref": "#/$defs/handler" }
    },

    "server_script": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scriptEntry" }
    },

    "shutdown_after_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Binding-specific directive: cancel the runner this many ms after RunAsync starts. Useful for drain/shutdown cases. Bindings without this capability should skip such cases."
    },

    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http"],
      "properties": {
        "duration_max_ms": { "type": "integer", "minimum": 1 },
        "http": {
          "type": "array",
          "items": { "$ref": "#/$defs/httpExpectation" }
        }
      }
    }
  },

  "$defs": {
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_key", "behavior"],
      "properties": {
        "job_key": { "type": "string", "minLength": 1 },
        "is_default": { "type": "boolean" },
        "schedule": { "type": "string", "description": "If set, self-register via /v1/jobs/register" },
        "behavior": {
          "type": "string",
          "enum": ["noop", "throw", "sleep", "log", "stream_logs"]
        },
        "error_message": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "level": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error"] },
        "message": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "interval_ms": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "behavior": { "const": "throw" } }, "required": ["behavior"] },
          "then": { "required": ["error_message"] }
        },
        {
          "if": { "properties": { "behavior": { "const": "sleep" } }, "required": ["behavior"] },
          "then": { "required": ["duration_ms"] }
        },
        {
          "if": { "properties": { "behavior": { "const": "log" } }, "required": ["behavior"] },
          "then": { "required": ["message"] }
        },
        {
          "if": { "properties": { "behavior": { "const": "stream_logs" } }, "required": ["behavior"] },
          "then": { "required": ["count", "interval_ms"] }
        }
      ]
    },

    "scriptEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "respond"],
      "properties": {
        "on": {
          "type": "string",
          "pattern": "^(GET|POST|PUT|DELETE|PATCH) /[^\\s]*$",
          "description": "HTTP method and path pattern. Path may include {param} placeholders."
        },
        "match_count": {
          "type": "integer",
          "minimum": 1,
          "description": "If set, this rule only applies to the Nth-occurring match (1-based). Otherwise the rule is the fallthrough for all matches."
        },
        "respond": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "body": {},
            "delay_ms": { "type": "integer", "minimum": 0, "description": "Artificial server delay before responding." },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },

    "httpExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
        "path": { "type": "string", "pattern": "^/" },
        "exact_count": { "type": "integer", "minimum": 0 },
        "min_count": { "type": "integer", "minimum": 0 },
        "max_count": { "type": "integer", "minimum": 0 },
        "headers": {
          "type": "object",
          "description": "Subset match on request headers (case-insensitive name, exact value or '*').",
          "additionalProperties": { "type": "string" }
        },
        "body_match": {
          "description": "Subset match on the request JSON body. '*' wildcards any non-empty value."
        }
      }
    }
  }
}
