<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Lightweight Checkstyle config for the Croniq Java SDK.

  Spotless (Palantir Java format) already handles whitespace, import
  ordering, and most layout concerns. Checkstyle's job here is the
  *semantic* checks Palantir doesn't make: unused imports, missing
  switch defaults, magic numbers in production code, etc. Anything that
  duplicates Spotless is intentionally omitted.

  Suppressions live in suppressions.xml.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
        <property name="optional" value="true"/>
    </module>

    <!-- Forbid tabs outright. Spotless enforces 4-space indent on save,
         but a checked-in tab slips past spotless if the file isn't touched. -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <module name="TreeWalker">
        <!-- Naming -->
        <module name="PackageName">
            <property name="format" value="^io\.croniq(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ConstantName">
            <!-- Allow `log` for SLF4J `private static final Logger log = ...`,
                 plus the standard SCREAMING_SNAKE_CASE for everything else.
                 Matches the universal Java convention used by Lombok's @Slf4j. -->
            <property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>

        <!-- Imports — Palantir formatter sorts them; we additionally
             forbid star imports and unused ones. -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- Code hygiene -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="MissingSwitchDefault"/>
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="EmptyStatement"/>
        <module name="DefaultComesLast"/>
        <module name="FallThrough"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="OneStatementPerLine"/>

        <!-- Modifiers -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- Whitespace — minimal set; Palantir handles the rest -->
        <module name="GenericWhitespace"/>
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
        </module>
    </module>
</module>
