# Force LF endings on Unix-oriented source. Spotless / ktlint's line-ending
# check otherwise fails on Windows runners because git's autocrlf converts
# checkouts to CRLF while the formatter expects LF (matches the .editorconfig).
*.java text eol=lf
*.kt   text eol=lf
*.kts  text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.toml text eol=lf
gradlew text eol=lf

# Windows-native scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary — never touch.
*.jar  binary
*.png  binary
