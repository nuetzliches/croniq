<Project>
  <!--
    These groups are conditioned on $(IsPackable), which each .csproj sets —
    AFTER Directory.Build.props is evaluated. They must therefore live here:
    Directory.Build.targets is imported after the project body, so the
    condition sees the final value. In Directory.Build.props the same
    condition silently never matched (properties evaluate in import order;
    only ITEMS evaluate after all properties), which is why 0.1.0–0.3.0
    shipped without license/readme/icon/tags metadata and without .snupkg
    symbol packages despite this configuration existing since day one.
  -->

  <PropertyGroup Label="Pack" Condition="'$(IsPackable)' == 'true'">
    <PackageTags>croniq;cron;scheduler;jobs;runner;worker;sdk</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>croniq-icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/nuetzliches/croniq</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nuetzliches/croniq</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="SourceLink" Condition="'$(IsPackable)' == 'true'">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Trim/AOT compatibility. Lives here (not Directory.Build.props) for the same
    evaluation-order reason as the groups above: the condition reads
    $(IsPackable), which each .csproj sets AFTER Directory.Build.props is
    imported. Enabling IsAotCompatible turns on the trim, AOT, and single-file
    analyzers (and implies IsTrimmable) so the whole public API is checked at
    build time — with TreatWarningsAsErrors, any regression is a hard error.

    The DI/options layer was annotated for this in issue #295:
      - handler type parameters carry [DynamicallyAccessedMembers(PublicConstructors)];
      - IConfiguration binding goes through the source-generated binder
        (EnableConfigurationBindingGenerator);
      - [OptionsValidator]-generated validators replace ValidateDataAnnotations().
    The JSON wire layer was already source-generated (CroniqJsonContext).
  -->
  <PropertyGroup Label="Trim/AOT" Condition="'$(IsPackable)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <PropertyGroup Label="MinVer" Condition="'$(IsPackable)' == 'true'">
    <MinVerTagPrefix>dotnet-sdk-v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>
</Project>
