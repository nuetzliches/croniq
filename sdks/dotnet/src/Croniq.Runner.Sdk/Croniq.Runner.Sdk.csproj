<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Croniq.Runner.Sdk</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Croniq.Runner.Sdk</RootNamespace>
    <AssemblyName>Croniq.Runner.Sdk</AssemblyName>
    <Description>Build job execution runners for the Croniq scheduling platform in .NET. Polls work via long-poll, dispatches typed handlers, streams structured logs, and reports completion. Includes Generic Host integration, options-pattern configuration, server-side cancellation, and AOT-friendly JSON.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Croniq.Runner.Sdk.Tests" />
    <InternalsVisibleTo Include="Croniq.Runner.Sdk.IntegrationTests" />
    <InternalsVisibleTo Include="Croniq.Runner.Sdk.SchemaCompat.Tests" />
    <InternalsVisibleTo Include="Croniq.Runner.Sdk.OpenTelemetry" />
  </ItemGroup>
</Project>
