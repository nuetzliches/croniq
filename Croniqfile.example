# Croniqfile — Billing Platform

server {
  listen :4000
  data_dir /var/lib/croniq
  db sqlite
  # Public base URL for invite / password-reset / OIDC login links.
  # Optional: if omitted, falls back to the CRONIQ_APP_URL env var, then to
  # the request's forwarded/Host headers. Set it to pin links on a
  # directly-exposed server. Quote the value — an unquoted // starts a comment.
  # app_url "https://cron.example.com"
}

pull_api {
  auth token {env.CRONIQ_JWT_SECRET}
  lease_ttl 60s
  # Dedup window for POST /v1/trigger idempotency keys: a repeat trigger
  # carrying the same idempotency_key coalesces to the existing execution
  # while it is still queued/running, or for this long after it was
  # created. Default: 10m.
  # trigger_dedup_window 10m
}

# HTTP MCP transport (Model Context Protocol). Mounted at /mcp on the same
# port as the REST API. Requires `mcp:read` (any tool) and `mcp:write`
# (mutation tools) — admin tokens always pass. Comment the block out or set
# `enabled false` to disable the endpoint entirely.
#
# `allowed_hosts` (issue #114) extends rmcp's built-in DNS-rebinding allowlist.
# `localhost`, `127.0.0.1`, and `::1` are always accepted; entries listed here
# are appended. Wildcards are NOT supported — enumerate every public hostname
# explicitly. For an IPv6 literal with port, quote it: `"[::1]:8443"`.
#
#   allowed_hosts cron.internal admin.example.com
mcp {
  enabled true
}

# Server-wide policy flags. Default state is restrictive — every flag must
# be set explicitly to take effect.
#
# `dsl_adopt_on_mutate true` enables the explicit POST /v1/{resource}/{id}/adopt
# endpoint, which copies a DSL-managed resource (calendar, job, schedule) into
# the API store and excludes it from subsequent reloads. Without this flag,
# DSL resources are read-only via the API and mutations return 409. Uncomment
# the block to opt in.
#
# policy {
#   dsl_adopt_on_mutate true
# }

# SMTP transport for alert `email` channels + invitation / password-reset
# mails. Non-secret connection settings only — credentials stay in the
# environment (CRONIQ_SMTP_USERNAME / CRONIQ_SMTP_PASSWORD, or their _FILE
# variants). Any field omitted here falls back to the matching CRONIQ_SMTP_*
# env var; CRONIQ_SMTP_URL, when set, overrides this block entirely. Needs a
# server built with --features smtp, else mail degrades to a log-only sender.
# smtp {
#   host smtp.example.com
#   port 587
#   security starttls        # starttls | tls | none
#   from "Croniq <noreply@example.com>"
# }

observability {
  log { level info; format json; output stderr }
  metrics { listen :9900; path /metrics }
}

vars {
  default_tz Europe/Vienna
}

defaults {
  timezone {vars.default_tz}
  retry exponential { max_attempts 3; base 2s; cap 30s; jitter 0.25 }
  timeout 5m
  dead_letter { retention 30d }
}

# --- Kalender ---

calendar business-days {
  timezone {vars.default_tz}
  include weekly monday tuesday wednesday thursday friday
  exclude annual 01-01 01-06 05-01 08-15 10-26 11-01 12-08 12-25 12-26
  exclude annual 2026-04-06 2026-04-07
}

# --- Jobs ---

job billing:invoice-generate {
  description "Monatliche Rechnungsgenerierung"

  every weekday at 02:00 {
    calendar business-days
  }
  window 02:00..06:00

  runner { require billing; prefer eu-central }
  retry exponential { max_attempts 5; base 5s; cap 2m; jitter 0.3 }
  timeout 15m
  dead_letter { retention 60d; operator_hint "Billing-DB pruefen" }
  metadata { team billing; priority high }
}

job etl:data-sync {
  every 15 minutes
  retry fixed { max_attempts 2; delay 10s }
  timeout 10m
}

job ops:health-check:eu-west {
  every 5 minutes
  runner { require health-check; require eu-west }
  timeout 30s
}

job reports:monthly-summary {
  every 1st of month at 06:00 {
    calendar business-days
  }
  timeout 1h
}

job migration:schema-v2 {
  once at 2026-04-01T03:00:00Z
  timeout 30m
}

job legacy:old-report {
  disabled
  timeout 5m
}

# --- Generic shell / exec runners ---
# Pick these up by running `croniq-shell-runner` (ships in the same image as
# the server). The runner advertises the `shell-runner` capability — pin
# sensitive jobs to a dedicated pool with `runner { require shell-runner }`.

job ops:db-dump {
  every day at 03:00
  runner { require shell-runner }
  runner shell {
    command "pg_dump -U app app > /backups/app.sql"
    workdir /opt
    env { PGPASSWORD {env.PGPASSWORD} }
  }
  timeout 10m
  retry exponential { max_attempts 3 }
}

job ops:logrotate {
  every 1 hour
  runner { require shell-runner }
  runner exec { args /usr/sbin/logrotate /etc/logrotate.conf }
}
