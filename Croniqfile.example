# Croniqfile — Billing Platform

server {
  listen :4000
  data_dir /var/lib/croniq
  # Persistence backend. `sqlite` (default) keeps everything in
  # <data_dir>/croniq.db — one binary, zero setup, no external database.
  # A `postgres://…` (or `postgresql://…`) value here — or via the CRONIQ_DB
  # env var, which takes precedence — connects to PostgreSQL instead. That
  # requires a build with the `postgres` feature; the official Docker image and
  # release binaries include it. Any unrecognised value fails at boot, and a
  # postgres:// DSN on a build without the feature is rejected at boot too — the
  # server never silently falls back to SQLite.
  db sqlite
  # Public base URL for invite / password-reset / OIDC login links.
  # Optional: if omitted, falls back to the CRONIQ_APP_URL env var, then to
  # the request's forwarded/Host headers. Set it to pin links on a
  # directly-exposed server. Quote the value — an unquoted // starts a comment.
  # app_url "https://cron.example.com"
  # Age-based retention for terminal executions (completed/failed/cancelled).
  # The watchdog prunes finished executions — and their logs — older than this,
  # capping run-history growth on long-lived servers. `dead` executions are
  # left to dead-letter retention. Duration: 30d, 7d, 12h, … Omitted (the
  # default) ⇒ history is kept forever. Applies to both SQLite and Postgres.
  # execution_retention 30d
}

pull_api {
  # Runner-token signing secret is resolved from CRONIQ_JWT_SECRET, or
  # auto-generated into $DATA_DIR/jwt.secret on first boot. It is not
  # configured here — never put a secret in the Croniqfile.
  lease_ttl 60s
  # Dedup window for POST /v1/trigger idempotency keys: a repeat trigger
  # carrying the same idempotency_key coalesces to the existing execution
  # while it is still queued/running, or for this long after it was
  # created. Default: 10m.
  # trigger_dedup_window 10m
  # Bind each runner_id to the credential that first claimed it, so one
  # runner's key cannot poll, complete, renew or log as another runner
  # (first-writer-wins; DELETE /v1/runners/{id} releases a binding).
  # "off" trusts the runner_id in the request body instead. Default: strict.
  # runner_identity_binding strict
}

# HTTP MCP transport (Model Context Protocol). Mounted at /mcp on the same
# port as the REST API. Requires `mcp:read` (any tool) and `mcp:write`
# (mutation tools) — admin tokens always pass. Comment the block out or set
# `enabled false` to disable the endpoint entirely.
#
# `allowed_hosts` (issue #114) extends rmcp's built-in DNS-rebinding allowlist.
# `localhost`, `127.0.0.1`, and `::1` are always accepted; entries listed here
# are appended. Wildcards are NOT supported — enumerate every public hostname
# explicitly. For an IPv6 literal with port, quote it: `"[::1]:8443"`.
#
#   allowed_hosts cron.internal admin.example.com
mcp {
  enabled true
}

# Server-wide policy flags. Default state is restrictive — every flag must
# be set explicitly to take effect.
#
# `dsl_adopt_on_mutate true` enables the explicit POST /v1/{resource}/{id}/adopt
# endpoint, which copies a DSL-managed resource (calendar, job, schedule) into
# the API store and excludes it from subsequent reloads. Without this flag,
# DSL resources are read-only via the API and mutations return 409. Uncomment
# the block to opt in.
#
# policy {
#   dsl_adopt_on_mutate true
# }

# SMTP transport for alert `email` channels + invitation / password-reset
# mails. Non-secret connection settings only — credentials stay in the
# environment (CRONIQ_SMTP_USERNAME / CRONIQ_SMTP_PASSWORD, or their _FILE
# variants). Any field omitted here falls back to the matching CRONIQ_SMTP_*
# env var; CRONIQ_SMTP_URL, when set, overrides this block entirely. Needs a
# server built with --features smtp, else mail degrades to a log-only sender.
# smtp {
#   host smtp.example.com
#   port 587
#   security starttls        # starttls | tls | none
#   from "Croniq <noreply@example.com>"
# }

observability {
  log { level info; format json; output stderr }
  metrics { listen :9900; path /metrics }
}

vars {
  default_tz Europe/Vienna
}

defaults {
  timezone {vars.default_tz}
  retry exponential { max_attempts 3; base 2s; cap 30s; jitter 0.25 }
  timeout 5m
  # dead_letter: `enabled false` turns dead-lettering off — an execution that
  # exhausts its retries is dropped instead of queued for triage. Use
  # `defaults { dead_letter { enabled false } }` for "off by default, opt in
  # per job". A job's own retry/dead_letter block overrides only the fields it
  # names; anything it omits falls back to this defaults block (field-merge).
  # `retention 0` keeps dead letters forever: the auto-purge sweep skips them,
  # so they only leave the queue when you delete them (UI bulk-delete or the
  # /v1/dead-letters API). Rows backfilled by an upgrade (migration 009)
  # behave the same way — no TTL was guessed for them.
  dead_letter { enabled true; retention 30d }
}

# --- Kalender ---

calendar business-days {
  # Die Zone, in der die Regeln unten gelesen werden — fuer JEDEN Job, der
  # diesen Kalender referenziert. Ein Feiertagskalender ist oesterreichisch,
  # unabhaengig davon, in welcher Zone der konsultierende Job laeuft; deshalb
  # steht die Zone hier und nicht am Job. Ohne Angabe erbt der Kalender
  # `defaults { timezone }`, sonst gilt UTC — nie die Zone des Jobs.
  timezone {vars.default_tz}
  include weekly monday tuesday wednesday thursday friday
  exclude annual 01-01 01-06 05-01 08-15 10-26 11-01 12-08 12-25 12-26
  exclude annual 2026-04-06 2026-04-07
}

# --- Jobs ---

job billing:invoice-generate {
  description "Monatliche Rechnungsgenerierung"

  every weekday at 02:00 {
    calendar business-days
  }
  window 02:00..06:00

  runner { require billing; prefer eu-central }
  retry exponential { max_attempts 5; base 5s; cap 2m; jitter 0.3 }
  timeout 15m
  # replay_max_age: opt-in staleness guard. This job's output is coupled to
  # its scheduled month, so replaying a dead letter more than 7 days after its
  # original scheduled_for is refused (409) unless the operator forces it — a
  # month-late replay would otherwise bill the wrong period. Handlers read the
  # logical time from the execution's scheduled_for, not wall-clock now.
  dead_letter { retention 60d; replay_max_age 7d; operator_hint "Billing-DB pruefen" }
  metadata { team billing; priority high }
}

job etl:data-sync {
  every 15 minutes
  retry fixed { max_attempts 2; delay 10s }
  timeout 10m
}

job ops:health-check:eu-west {
  every 5 minutes
  runner { require health-check; require eu-west }
  timeout 30s
  # Per-job history cap: keep only the newest N terminal executions of this
  # job; the watchdog prunes older ones (and their logs). Handy for very
  # high-frequency jobs. Applies on top of the global execution_retention age
  # sweep; also settable in `defaults { }`. Ignored for ephemeral jobs.
  keep_last 500
}

job reports:monthly-summary {
  every 1st of month at 06:00 {
    calendar business-days
  }
  # Job-level timezone — overrides `defaults { timezone … }` for this job only.
  # Precedence: schedule option (`every … at … { timezone … }`) > this
  # directive > `defaults { }`. With none of the three, wall-clock times are
  # interpreted as UTC (croniq never reads the host's TZ, so the same file
  # fires at the same instant in every environment) — `croniq validate` warns
  # when a wall-clock schedule has no zone. An unknown IANA name is a hard
  # error everywhere, rather than a silent fallback to UTC.
  #
  # Gilt nur fuer die Zeiten DIESES Jobs. Der oben referenzierte Kalender
  # `business-days` wird in SEINER Zone (Europe/Vienna) ausgewertet, nicht in
  # Europe/London: 06:00 London ist 07:00 Wien, also derselbe Wochentag — bei
  # groesseren Zonenabstaenden kann der Kalendertag aber ein anderer sein.
  timezone Europe/London
  timeout 1h
}

job migration:schema-v2 {
  once at 2026-04-01T03:00:00Z
  timeout 30m
}

# A job that reconciles state which changes at DEPLOY time — pushing a rotated
# credential to an external component, warming a cache from new config — has a
# blind window between the deploy and its next scheduled fire. `run_on_register`
# closes it: the job fires once when croniq first sees the key, and again
# whenever its compiled definition changes.
job integration:credential-sync {
  every day at 04:20
  # Not on every reload or restart: croniq records which definition it last
  # fired for, so a restart storm and a `--watch` save that changes nothing
  # both fire nothing. Any behavioural change counts (schedule, runner,
  # timeout, metadata, the shell command …); reworded `description` and
  # changed `tags` do not.
  run_on_register
  # The adoption fire is claimed like any other, so this still applies: it
  # will not double up on a run already in flight.
  singleton
  runner { require credentials }
}

job legacy:old-report {
  disabled
  timeout 5m
}

# --- Generic shell / exec runners ---
# Pick these up by running `croniq-shell-runner` (ships in the same image as
# the server). The runner advertises the `shell-runner` capability — pin
# sensitive jobs to a dedicated pool with `runner { require shell-runner }`.

job ops:db-dump {
  every day at 03:00
  runner { require shell-runner }
  runner shell {
    command "pg_dump -U app app > /backups/app.sql"
    workdir /opt
    env { PGPASSWORD {env.PGPASSWORD} }
  }
  timeout 10m
  retry exponential { max_attempts 3 }
  # Never run two dumps at once: a fire that overlaps a still-running
  # execution stays queued until it finishes. `singleton` is shorthand
  # for `max_concurrent 1`; use `max_concurrent N` to allow up to N
  # overlapping executions instead (the two are mutually exclusive).
  # The guard is per job and does not compose across jobs: to make a set
  # of jobs share one budget (a common upstream rate limit, say), use a
  # `concurrency_group` — see below and docs/operations.md.
  singleton
}

# A budget shared by a *set* of jobs (issue #546). Use it when the limit is a
# property of something external — a third-party API's rate limit, a database
# connection pool — rather than of any one job. At most `max_concurrent`
# executions across every job naming the group may be in flight at a time,
# regardless of which. Referencing an undefined group is a config error, and
# the guard requires `queued` mode (the default): it counts persisted
# executions, so `ephemeral` jobs cannot participate.
concurrency_group crm-api {
  max_concurrent 1
}

job crm:sync-contacts {
  every day at 03:00
  concurrency_group crm-api
  runner shell { command "/usr/local/bin/crm-sync contacts" }
}

job crm:push-status {
  every 15 minutes
  concurrency_group crm-api
  runner shell { command "/usr/local/bin/crm-push status" }
}

job ops:logrotate {
  every 1 hour
  runner { require shell-runner }
  runner exec { args /usr/sbin/logrotate /etc/logrotate.conf }
}
