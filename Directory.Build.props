<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Tests'))">
    <IsTestProject>true</IsTestProject>
    <!-- Coverage is opt-in to avoid intermittent file locking issues when coverlet rewrites assemblies on Windows. -->
    <CollectCoverage Condition="'$(CollectCoverage)' == ''">false</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildProjectDirectory)\TestResults\coverage\$(MSBuildProjectName)\coverage</CoverletOutput>
    <ExcludeByFile>**\bin\**,**\obj\**,**/bin/**,**/obj/**,**/Migrations/**/*.cs,**\Migrations\**\*.cs,**/Program.cs,**\Program.cs,**/CronExpression.cs,**\CronExpression.cs</ExcludeByFile>
  </PropertyGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Tests'))">
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="CleanLegacyCoverletOutput" BeforeTargets="Build" Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Tests'))">
    <PropertyGroup>
      <LegacyCoverletOutput>$(MSBuildProjectDirectory)\TestResults\coverage\$(MSBuildProjectName)</LegacyCoverletOutput>
    </PropertyGroup>
    <!-- Remove leftover single-file coverage artifact so coverlet can create the new directory structure. -->
    <Delete Condition="Exists('$(LegacyCoverletOutput)') and !$([System.IO.Directory]::Exists('$(LegacyCoverletOutput)'))" Files="$(LegacyCoverletOutput)" />
  </Target>
</Project>
